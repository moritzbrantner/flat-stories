{
  "name": "flat-stories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:source": "bun run source:prepare && bun run dev",
    "renderer:build": "bash scripts/build-renderer-wasm.sh",
    "renderer:test": "cargo test --locked --manifest-path renderer-wasm/Cargo.toml",
    "bench:renderer": "bun run renderer:build && bun scripts/benchmark-renderers.ts",
    "bench:renderer:browser": "bun scripts/run-browser-renderer-benchmark.ts",
    "build": "bun run renderer:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test && bun run renderer:test && bun run build",
    "source:prepare": "node scripts/source-deps.mjs prepare",
    "source:status": "node scripts/source-deps.mjs status",
    "source:smoke": "node scripts/source-deps.mjs smoke",
    "source:restore": "node scripts/source-deps.mjs restore",
    "verify:source": "bun run source:prepare && bun run source:smoke && bun run check",
    "verify:registry": "bun run source:restore && bun run check",
    "fixture:2d-lab": "bun run scripts/export-2d-lab-nova-fixture.ts"
  },
  "dependencies": {
    "@moenarch/editor-core": "^0.4.1",
    "@moritzbrantner/layer-editor": "^0.2.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.4.4"
}
